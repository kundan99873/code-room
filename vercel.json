{
  "redirects": [
    {
      "source": "/playground",
      "destination": "/online-compiler",
      "permanent": true
    },
    {
      "source": "/playground/",
      "destination": "/online-compiler",
      "permanent": true
    },
    {
      "source": "/json",
      "destination": "/json-formatter",
      "permanent": true
    },
    {
      "source": "/json/",
      "destination": "/json-formatter",
      "permanent": true
    },
    {
      "source": "/pen",
      "destination": "/web-pen",
      "permanent": true
    },
    {
      "source": "/pen/",
      "destination": "/web-pen",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}